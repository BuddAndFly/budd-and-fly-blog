---
import { webpSet } from '@/lib/img';
import Base from '@/layouts/Base.astro';
import { getDestinations } from '@/lib/content';
import { MONTHS } from '@/data/site';

export async function getStaticPaths() {
  return MONTHS.map((m, i) => ({ params: { mois: m.slug }, props: { i } }));
}

const { i } = Astro.props as { i: number };
const month = MONTHS[i]!;
const all = await getDestinations();
const ideal = all.filter((d) => !d.data.advisory && d.data.months[i]!.rating === 2);
const good = all.filter((d) => !d.data.advisory && d.data.months[i]!.rating === 1);
// Page trop mince pour Google tant qu'il y a peu de guides publiés : on ne l'indexe pas.
const thin = ideal.length < 5;
const title = `Où partir en ${month.name} ? Nos idées de voyage`;
const description = `Où partir en ${month.name} : ${ideal.length} destinations où la saison est idéale, et ${good.length} autres bonnes idées, avec météo, affluence et guide PDF gratuit.`;
const prev = MONTHS[(i + 11) % 12]!;
const next = MONTHS[(i + 1) % 12]!;
---
<Base title={title} description={description.slice(0, 158)} noindex={thin}>
  <section class="hero hero--plain head">
    <div class="hero__inner">
      <nav aria-label="Fil d'Ariane" class="crumbs"><a href="/ou-partir/">Où partir</a> / {month.name}</nav>
      <h1>Où partir en {month.name} ?</h1>
      <p class="muted">Les destinations où la météo, l'affluence et les conditions sont au rendez-vous en {month.name}, d'après nos guides.</p>
    </div>
  </section>

  <div class="narrow body">
    <section>
      <h2>La saison idéale</h2>
      {ideal.length === 0 && <p class="muted">Aucun guide publié ne recommande encore ce mois. Reviens bientôt.</p>}
      <div class="rows">
        {ideal.map((d) => (
          <a class="dest" href={`/destinations/${d.id}/#quand-partir`}>
            {d.data.hero ? <picture>{webpSet(d.data.hero.src) && <source type="image/webp" srcset={webpSet(d.data.hero.src)} sizes="320px" />}<img src={d.data.hero.src} alt={d.data.hero.alt} loading="lazy" width="320" height="213" /></picture> : <span class="dest__empty">{d.data.name}</span>}
            <span class="dest__body">
              <span class="kicker">{d.data.continent}</span>
              <span class="row__title">{d.data.name}</span>
              <span class="row__meta">{d.data.months[i]!.note}</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    {good.length > 0 && (
      <section>
        <h2>Aussi une bonne idée</h2>
        <div class="rows">
          {good.map((d) => (
            <a class="row" href={`/destinations/${d.id}/#quand-partir`}>
              <span><span class="row__title">{d.data.name}</span><br /><span class="row__meta">{d.data.months[i]!.note}</span></span>
              <span class="tag">Guide</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <nav class="pager" aria-label="Autres mois">
      <a href={`/ou-partir/${prev.slug}/`}>← Où partir en {prev.name}</a>
      <a href={`/ou-partir/${next.slug}/`}>Où partir en {next.name} →</a>
    </nav>

    <div class="box cta">
      <p class="serif">Tu ne sais pas encore où aller ?</p>
      <p class="muted">Le Visa voyageur te propose des destinations selon ton rythme, ton budget et tes envies.</p>
      <a href="/visa-voyageur/" class="btn btn--accent">Passer mon Visa (2 min)</a>
    </div>
  </div>
</Base>

<style>
  .head { min-height: 0; }
  .crumbs { font-size: 13px; font-weight: 600; letter-spacing: .22em; text-transform: uppercase; }
  .crumbs a { color: inherit; text-decoration: none; }
  .body { display: flex; flex-direction: column; gap: 56px; padding-top: 56px; }
  h2 { font-size: clamp(28px, 3.2vw, 36px); margin-bottom: 18px; }
  .dest { display: flex; gap: 20px; padding: 18px 0; border-bottom: 1px solid var(--line); text-decoration: none; align-items: center; }
  .dest img, .dest__empty { width: 160px; height: 110px; object-fit: cover; flex-shrink: 0; background: var(--sand); display: flex; align-items: center; justify-content: center; font-family: var(--serif); color: var(--accent); }
  .dest__body { display: flex; flex-direction: column; gap: 4px; }
  .pager { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; font-weight: 600; }
  .pager a { color: var(--accent); }
  .cta { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
  .cta .serif { font-size: 28px; }
  @media (max-width: 560px) { .dest { flex-direction: column; align-items: stretch; } .dest img, .dest__empty { width: 100%; height: 180px; } }
</style>
