---
import Base from '@/layouts/Base.astro';
---
<Base title="Page introuvable" description="Cette page n'existe pas ou a été déplacée." noindex>
  <section class="hero hero--plain">
    <div class="hero__inner">
      <span class="kicker">Erreur 404</span>
      <h1>Cette page s'est perdue en route</h1>
      <p class="muted">Elle n'existe pas ou a changé d'adresse.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;justify-content:center">
        <a href="/destinations/" class="btn btn--accent">Voir les destinations</a>
        <a href="/" class="btn btn--outline">Accueil</a>
      </div>
    </div>
  </section>
</Base>
