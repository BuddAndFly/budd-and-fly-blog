---
import Base from '@/layouts/Base.astro';
import GuideCard from '@/components/GuideCard.astro';
import { getDestinations } from '@/lib/content';
import { MONTHS, SITE } from '@/data/site';

const destinations = await getDestinations();
const order = ['Europe', 'Asie', 'Moyen-Orient', 'Afrique', 'Amérique du Nord', 'Amérique centrale et Caraïbes', 'Amérique du Sud', 'Océanie', 'Antarctique'];
const groups = order
  .map((c) => ({ name: c, items: destinations.filter((d) => d.data.continent === c).sort((a, b) => a.data.name.localeCompare(b.data.name, 'fr')) }))
  .filter((g) => g.items.length > 0);
const faq = [
  { q: 'Les guides de voyage Budd&Fly sont-ils vraiment gratuits ?', a: `Oui. Les ${destinations.length} guides sont gratuits, à lire en ligne ou à télécharger en PDF, sans inscription, sans compte et sans adresse e-mail.` },
  { q: 'Que contient un guide de voyage gratuit Budd&Fly ?', a: "Les formalités d'entrée pour les voyageurs français avec leur source officielle, la santé, la sécurité, la meilleure saison mois par mois, les villes à voir, des itinéraires et, quand nous en avons un de fiable, un bon plan gratuit propre à la destination. Le budget indicatif est indiqué quand nous avons pu le vérifier." },
  { q: 'Comment télécharger un guide de voyage en PDF ?', a: "Ouvre le guide de ta destination, choisis la durée, le mois de départ et ton style de voyage, puis clique sur « Télécharger le guide gratuit ». Tu obtiens un PDF au format A4, à imprimer ou à garder hors connexion." },
  { q: 'Les informations sont-elles à jour ?', a: "Chaque guide affiche sa date de mise à jour et renvoie vers ses sources officielles, comme les conseils aux voyageurs de France Diplomatie. Les règles d'entrée peuvent changer : vérifie toujours la fiche officielle juste avant de partir." },
];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Guides de voyage gratuits en PDF',
    description: `${destinations.length} guides de voyage gratuits en PDF, sans inscription.`,
    url: new URL('/destinations/', SITE.url).href,
    inLanguage: 'fr',
    isAccessibleForFree: true,
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: destinations.length,
      itemListElement: destinations.map((d, i) => ({ '@type': 'ListItem', position: i + 1, name: `Guide de voyage ${d.data.name} gratuit`, url: new URL(`/destinations/${d.id}/`, SITE.url).href })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
---
<Base title={`Guides de voyage gratuits en PDF : ${destinations.length} destinations`} description={`${destinations.length} guides de voyage gratuits en PDF, sans inscription : formalités vérifiées, meilleure saison, villes et itinéraires. À lire en ligne ou à imprimer.`} jsonLd={jsonLd}>
  <section class="hero hero--plain head">
    <div class="hero__inner">
      <span class="free-badge">100 % gratuit · sans inscription</span>
      <h1>Guides de voyage gratuits</h1>
      <p class="muted">{destinations.length} destinations, chacune avec son guide PDF gratuit : formalités vérifiées, meilleure saison, villes et itinéraires. Pas de compte, pas d'e-mail, pas de paywall.</p>
      <form class="filter" role="search" data-filter>
        <label class="field field--line">Pays ou ville
          <input type="search" name="q" placeholder="Japon, Kyoto, Maroc…" autocomplete="off" />
        </label>
        <label class="field field--line">Partir en
          <select name="mois"><option value="">N'importe quand</option>{MONTHS.map((m, i) => <option value={m.slug} data-i={i}>{m.name[0]!.toUpperCase() + m.name.slice(1)}</option>)}</select>
        </label>
      </form>
      <p class="count" data-count aria-live="polite"></p>
    </div>
  </section>

  <div class="wrap">
    {groups.map((g) => (
      <section class="section group" id={g.name} data-group>
        <div class="rule-title"><h2>{g.name}</h2></div>
        <div class="cards">
          {g.items.map((d) => (
            <div data-item data-search={norm([d.data.name, ...d.data.cities.map((c) => c.name)].join(' '))} data-months={d.data.months.map((m) => m.rating).join('')}>
              <GuideCard d={d} />
            </div>
          ))}
        </div>
      </section>
    ))}

    <section class="section faq-hub" id="faq">
      <div class="rule-title"><h2>Questions fréquentes sur nos guides gratuits</h2></div>
      {faq.map((f) => (
        <details class="faq-hub__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>
  </div>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-filter]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-item]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')];
  const count = document.querySelector('[data-count]');
  const months = ['janvier','fevrier','mars','avril','mai','juin','juillet','aout','septembre','octobre','novembre','decembre'];
  const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();
  if (form) {
    const params = new URLSearchParams(location.search);
    (form.elements.namedItem('q') as HTMLInputElement).value = params.get('q') ?? '';
    (form.elements.namedItem('mois') as HTMLSelectElement).value = params.get('mois') ?? '';
    const apply = () => {
      const q = norm((form.elements.namedItem('q') as HTMLInputElement).value);
      const m = months.indexOf((form.elements.namedItem('mois') as HTMLSelectElement).value);
      let n = 0;
      for (const el of items) {
        const okQ = !q || (el.dataset.search ?? '').includes(q);
        const okM = m < 0 || (el.dataset.months ?? '')[m] === '2';
        el.hidden = !(okQ && okM);
        if (!el.hidden) n++;
      }
      groups.forEach((g) => (g.hidden = !g.querySelector('[data-item]:not([hidden])')));
      if (count) count.textContent = q || m >= 0 ? (n ? `${n} destination${n > 1 ? 's' : ''}` : 'Aucune destination ne correspond. Essaie un autre mois ou un autre nom.') : '';
    };
    form.addEventListener('input', apply);
    form.addEventListener('submit', (e) => e.preventDefault());
    apply();
  }
</script>

<style>
  .faq-hub { max-width: 820px; }
  .faq-hub__item { border-bottom: 1px solid var(--line); padding: 16px 0; }
  .faq-hub__item summary { cursor: pointer; font-weight: 600; }
  .faq-hub__item p { margin-top: 10px; color: var(--ink-soft); }
  .head { min-height: 0; }
  .filter { display: flex; flex-wrap: wrap; gap: 16px; width: 100%; max-width: 640px; margin-top: 8px; text-align: left; }
  .filter .field { flex: 1 1 220px; }
  .filter input, .filter select { background: transparent; }
  .count { font-size: 14px; color: var(--muted); min-height: 1.5em; }
  .group { scroll-margin-top: 80px; }
</style>
