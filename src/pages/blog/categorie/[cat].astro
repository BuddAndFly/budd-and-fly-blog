---
import Base from '@/layouts/Base.astro';
import PostList from '@/components/PostList.astro';
import { getArticles } from '@/lib/content';
import { CATEGORIES } from '@/data/site';

export async function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { cat: c.slug }, props: { name: c.name } }));
}
const { name } = Astro.props as { name: string };
const articles = (await getArticles()).filter((a) => a.data.category === name);
const intro: Record<string, string> = {
  'Voyager seul': 'Partir seul, en sécurité, sans se sentir seul : nos conseils pour un premier voyage en solo et pour rencontrer du monde en route.',
  'Partir à deux': 'Trouver un compagnon de voyage, se mettre d’accord avant le départ, partager les frais : tout pour bien voyager à deux.',
  'Petits budgets': 'Voyager loin sans se ruiner : destinations abordables, astuces pour les vols et l’hébergement.',
  'Préparer': 'Papiers, santé, assurance, argent, bagages : les étapes pour partir l’esprit tranquille.',
  'Idées de voyage': 'Des destinations et des itinéraires pour trouver ton prochain voyage.',
};
---
<Base title={`${name} : nos conseils de voyage`} description={(intro[name] ?? name).slice(0, 158)} noindex={articles.length < 3}>
  <section class="hero hero--plain head">
    <div class="hero__inner">
      <nav aria-label="Fil d'Ariane" class="crumbs"><a href="/blog/">Le blog</a> / {name}</nav>
      <h1>{name}</h1>
      <p class="muted">{intro[name]}</p>
    </div>
  </section>
  <div class="wrap section"><PostList articles={articles} /></div>
</Base>
<style>
  .head { min-height: 0; }
  .crumbs { font-size: 13px; font-weight: 600; letter-spacing: .22em; text-transform: uppercase; }
  .crumbs a { color: inherit; text-decoration: none; }
</style>
