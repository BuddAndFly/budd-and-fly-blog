---
import Base from '@/layouts/Base.astro';
import PostList from '@/components/PostList.astro';
import { getArticles } from '@/lib/content';
import { CATEGORIES } from '@/data/site';
const articles = await getArticles();
---
<Base title="Blog voyage : voyager seul, à deux, petit budget, idées" description="Voyager seul ou à deux, trouver un compagnon de voyage, partir petit budget, choisir sa destination : des conseils concrets, vérifiés et sans blabla.">
  <section class="hero hero--plain head">
    <div class="hero__inner">
      <span class="kicker">Le blog</span>
      <h1>Des conseils de voyage qui servent vraiment</h1>
      <p class="blog-intro">Voyager seul ou à deux, trouver avec qui partir, dépenser moins, choisir où aller : du concret, vérifié, sans blabla.</p>
      <nav class="cats" aria-label="Catégories">{CATEGORIES.map((c) => <a href={`/blog/categorie/${c.slug}/`}>{c.name}</a>)}</nav>
    </div>
  </section>
  <div class="wrap section"><PostList articles={articles} /></div>
</Base>
<style>
  .head { min-height: 0; }
  .blog-intro { max-width: 620px; margin: 0 auto; color: var(--muted); font-size: 17px; }
  .cats { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
  .cats a { border: 1px solid var(--line-strong); padding: 8px 16px; text-decoration: none; font-size: 14px; font-weight: 600; }
  .cats a:hover { border-color: var(--ink); }
</style>
