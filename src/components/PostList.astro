---
import { webpSet } from '@/lib/img';
import { frDate, type Article } from '@/lib/content';
interface Props { articles: Article[]; }
const { articles } = Astro.props;
---
{articles.length === 0 ? (
  <p class="muted empty">Les articles arrivent bientôt.</p>
) : (
  <div class="posts">
    {articles.map((a) => (
      <a class="post" href={`/blog/${a.id}/`}>
        {a.data.hero ? <picture>{webpSet(a.data.hero.src) && <source type="image/webp" srcset={webpSet(a.data.hero.src)} sizes="(max-width: 700px) 100vw, 400px" />}<img src={a.data.hero.src} alt={a.data.hero.alt} loading="lazy" width="800" height="533" /></picture> : <span class="post__empty" data-cat={a.data.category}><span>{a.data.category}</span></span>}
        <span class="kicker">{a.data.category}</span>
        <span class="post__title">{a.data.title}</span>
        <span class="muted small">{frDate(a.data.updatedAt)}{a.data.status === 'brouillon' ? ' · brouillon' : ''}</span>
      </a>
    ))}
  </div>
)}
<style>
  .posts { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr)); gap: 48px 40px; }
  .post { min-width: 0; }
  @media (max-width: 480px) { .posts { gap: 36px; } .post img, .post__empty { height: 220px; } .post__title { font-size: 23px; } }
  .post { display: flex; flex-direction: column; gap: 12px; text-decoration: none; text-align: center; }
  .post img, .post__empty { width: 100%; height: 260px; object-fit: cover; margin-bottom: 6px; background: var(--sand); display: block; }
  .post__empty { position: relative; display: flex; align-items: center; justify-content: center; overflow: hidden; background: linear-gradient(135deg, var(--c1, #1f6b3f), var(--c2, #3d8f62)); }
  .post__empty::before { content: ''; position: absolute; inset: 0; background: repeating-linear-gradient(135deg, rgba(255,255,255,.06) 0 2px, transparent 2px 14px); }
  .post__empty::after { content: ''; position: absolute; inset: 12px; border: 1px solid rgba(255,255,255,.35); }
  .post__empty span { position: relative; z-index: 1; font-size: 12px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #fff; }
  .post__empty[data-cat='Voyager seul'] { --c1: #1f4e6b; --c2: #2f7a8a; }
  .post__empty[data-cat='Partir à deux'] { --c1: #7a1f3d; --c2: #b04a5a; }
  .post__empty[data-cat='Petits budgets'] { --c1: #8a6a1f; --c2: #b8933a; }
  .post__empty[data-cat='Préparer'] { --c1: #3d2f6b; --c2: #5a4a9a; }
  .post__empty[data-cat='Idées de voyage'] { --c1: #1f6b3f; --c2: #4a9a5a; }
  .post__title { font-family: var(--serif); font-size: 26px; line-height: 1.2; }
  .post:hover .post__title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; }
  .small { font-size: 13px; }
  .empty { text-align: center; }
</style>
