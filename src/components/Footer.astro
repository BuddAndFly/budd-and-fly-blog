---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap site-footer__grid">
    <div class="site-footer__brand">
      <a href="/" class="brand"><img src="/logo-buddfly.png" alt="" width="36" height="36" /><span>Budd&amp;Fly</span></a>
      <p class="muted">Guides de voyage gratuits et vérifiés. Et une application pour trouver avec qui partir.</p>
      <a href="/app" class="app-link">Tester l'application</a>
    </div>
    <nav aria-label="Guides">
      <span class="kicker kicker--ink">Guides</span>
      <a href="/destinations/">Toutes les destinations</a>
      <a href="/ou-partir/">Où partir, mois par mois</a>
      <a href="/preparer/">Préparer son voyage</a>
    </nav>
    <nav aria-label="Voyager">
      <span class="kicker kicker--ink">Voyager</span>
      <a href="/blog/categorie/voyager-seul/">Voyager seul</a>
      <a href="/blog/categorie/partir-a-deux/">Partir à deux</a>
      <a href="/visa-voyageur/">Mon Visa voyageur</a>
      <a href="/blog/">Tous les articles</a>
    </nav>
    <nav aria-label="Budd&Fly">
      <span class="kicker kicker--ink">Budd&amp;Fly</span>
      <a href="/a-propos/">Qui sommes-nous</a>
      <a href="/a-propos/#methode">Comment on vérifie</a>
      <a href="/mentions-legales/">Mentions légales</a>
      <a href="/confidentialite/">Confidentialité</a>
    </nav>
  </div>
  <div class="wrap site-footer__bottom">© {year} Budd&amp;Fly</div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); margin-top: 96px; }
  .site-footer__grid { display: grid; grid-template-columns: 2fr repeat(3, 1fr); gap: 40px; padding-top: 56px; padding-bottom: 40px; }
  .site-footer__brand { display: flex; flex-direction: column; gap: 14px; max-width: 340px; font-size: 15px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .brand img { border-radius: 10px; }
  .brand span { font-family: var(--serif); font-size: 24px; }
  .app-link { color: var(--accent); font-weight: 600; }
  nav { display: flex; flex-direction: column; gap: 10px; font-size: 15px; }
  nav a { text-decoration: none; }
  nav a:hover { text-decoration: underline; }
  .site-footer__bottom { border-top: 1px solid var(--line); padding-top: 20px; padding-bottom: 28px; font-size: 13px; color: var(--muted); }
  @media (max-width: 800px) { .site-footer__grid { grid-template-columns: 1fr 1fr; } .site-footer__brand { grid-column: 1 / -1; } }
</style>
