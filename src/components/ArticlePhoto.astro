---
/** Photo dans le texte d'un article, avec légende et crédit (obligatoire pour les licences CC BY / BY-SA). */
interface Props {
  photo: { src: string; alt: string; credit: { author: string; license: string; url?: string | undefined } | null };
}
const { photo } = Astro.props;
---
<figure class="aphoto">
  <img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" width="1600" height="1067" />
  <figcaption>
    {photo.alt}
    {photo.credit && <span class="aphoto__credit"> · Photo {photo.credit.url ? <a href={photo.credit.url} rel="noopener nofollow">{photo.credit.author}</a> : photo.credit.author}, {photo.credit.license}</span>}
  </figcaption>
</figure>
<style>
  .aphoto { margin: 2.2em 0; }
  .aphoto img { width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; display: block; }
  .aphoto figcaption { margin-top: 8px; font-size: 13.5px; color: var(--muted); }
  .aphoto__credit a { color: inherit; }
</style>
